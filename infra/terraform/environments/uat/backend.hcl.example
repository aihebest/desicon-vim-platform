# Copy to backend.hcl (gitignored) and fill in with the values printed by
# infra/scripts/bootstrap-state.ps1. Then, from this folder:
#
#   terraform init -backend-config=backend.hcl
#
# use_azuread_auth = true is already set in providers.tf, so no storage key is
# needed: your own Entra sign-in (az login) must hold "Storage Blob Data
# Contributor" on the state storage account (bootstrap-state.ps1 grants it).

resource_group_name  = "rg-vim-tfstate"
storage_account_name = "stvimtfstateXXXX"
container_name       = "tfstate"
key                  = "uat.terraform.tfstate"
