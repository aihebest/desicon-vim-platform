<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Vendor portal: Razor Pages, Microsoft Entra External ID sign-in (vendors, not staff). -->
  <PropertyGroup>
    <RootNamespace>Desicon.Vim.Portal</RootNamespace>
    <UserSecretsId>desicon-vim-portal</UserSecretsId>
    <!-- Razor-generated and ASP.NET Core types are public by convention. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.16.1" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Desicon.Vim.Application\Desicon.Vim.Application.csproj" />
    <ProjectReference Include="..\Desicon.Vim.Infrastructure\Desicon.Vim.Infrastructure.csproj" />
  </ItemGroup>
</Project>
