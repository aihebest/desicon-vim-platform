<span class="badge badge-@Css">@Label</span>

@code {
    [Parameter, EditorRequired] public CaseStatus Status { get; set; }

    private string Css => Status switch
    {
        CaseStatus.Received or CaseStatus.Registered => "new",
        CaseStatus.UnderVerification => "review",
        CaseStatus.ReturnedToVendor => "returned",
        CaseStatus.Verified or CaseStatus.WithAccountsPayable => "ap",
        CaseStatus.EnteredInErp or CaseStatus.Paid or CaseStatus.Closed => "done",
        CaseStatus.Cancelled => "cancelled",
        _ => "new",
    };

    private string Label => Status switch
    {
        CaseStatus.ReturnedToVendor => "Returned to vendor",
        CaseStatus.UnderVerification => "Under verification",
        CaseStatus.WithAccountsPayable => "With AP",
        CaseStatus.EnteredInErp => "Entered in ERP",
        _ => Status.ToString(),
    };
}
