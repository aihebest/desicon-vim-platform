@page "/queue"
@attribute [Authorize(Policy = Policies.AnyVimUser)]
@inherits VimComponentBase

<PageTitle>My queue · Desicon VIM</PageTitle>
<h1>My queue</h1>
<p class="muted">Work waiting for you, based on your role.</p>

@foreach (var queue in _sections)
{
    <section class="panel">
        <h2>@queue.Title <span class="count">@queue.Result.TotalCount</span></h2>
        <CaseTable Items="queue.Result.Items" EmptyText="@queue.Empty" />
    </section>
}
@if (_sections.Count == 0 && Me is not null)
{
    <p class="muted">Your role has no work queue. Use <a href="cases">All cases</a> to search.</p>
}

@code {
    private sealed record Section(string Title, string Empty, PagedResult<CaseSummary> Result);

    private readonly List<Section> _sections = [];

    protected override async Task LoadAsync()
    {
        _sections.Clear();
        if (Me is null)
        {
            return;
        }

        var me = Me;
        await InScope(async sp =>
        {
            var q = sp.GetRequiredService<ICaseQueries>();
            if (me.HasRole(VimRole.AccountsPayable))
            {
                _sections.Add(new("Passed the automatic checks — confirm and accept", "Nothing waiting for Accounts.",
                    await q.SearchAsync(new CaseSearch(Statuses: [CaseStatus.WithAccountsPayable], PageSize: 50), default)));
                _sections.Add(new("Accepted — record the Business Central entry", "Nothing waiting.",
                    await q.SearchAsync(new CaseSearch(Statuses: [CaseStatus.Accepted], PageSize: 50), default)));
                _sections.Add(new("Returned to vendors (resubmit for those without portal access)", "Nothing returned.",
                    await q.SearchAsync(new CaseSearch(Statuses: [CaseStatus.ReturnedToVendor], PageSize: 50), default)));
            }

            if (me.HasRole(VimRole.FinanceManager))
            {
                _sections.Add(new("Exceptions waiting for your decision", "No exceptions.",
                    await q.SearchAsync(new CaseSearch(Statuses: [CaseStatus.ExceptionReview], PageSize: 50), default)));
                _sections.Add(new("Overdue (Accounts or exceptions)", "Nothing overdue.",
                    await q.SearchAsync(new CaseSearch(OverdueOnly: true, PageSize: 50), default)));
            }
        });
    }
}
