@page "/admin/routes"
@attribute [Authorize(Policy = Policies.Administration)]
@inherits VimComponentBase

<PageTitle>Invoice routing · Desicon VIM</PageTitle>
<h1>Invoice routing</h1>
<p class="muted">Which Responsible Officer verifies each category (SOP 7.3), and who covers for them. Use Entra object ids from the Microsoft Entra admin centre. Changes apply to cases sent for verification from now on.</p>

@if (Error is not null) { <div class="alert alert-error" role="alert">@Error</div> }
@if (Success is not null) { <div class="alert alert-ok" role="status">@Success</div> }

<section class="panel">
    <table class="grid">
        <thead><tr><th>Code</th><th>Category</th><th>Reviewer name</th><th>Reviewer object id</th><th>Delegate object ids (comma-separated)</th><th>Active</th></tr></thead>
        <tbody>
            @foreach (var r in _rows)
            {
                <tr>
                    <td>@r.Code</td>
                    <td><input @bind="r.DisplayName" /></td>
                    <td><input @bind="r.ReviewerName" /></td>
                    <td><input @bind="r.ReviewerId" /></td>
                    <td><input @bind="r.Delegates" /></td>
                    <td><input type="checkbox" @bind="r.Active" /></td>
                </tr>
            }
        </tbody>
    </table>
    <button class="primary" disabled="@(Busy || !CanEdit)" @onclick="SaveAsync">Save changes</button>
    @if (!CanEdit) { <span class="muted"> Only the Finance Manager can change routing.</span> }
</section>

@code {
    private sealed class Row
    {
        public string Code { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string ReviewerName { get; set; } = string.Empty;
        public string ReviewerId { get; set; } = string.Empty;
        public string Delegates { get; set; } = string.Empty;
        public bool Active { get; set; }
    }

    private List<Row> _rows = [];

    // Platform administrators can view routing; business ownership of the rules stays with Finance.
    private bool CanEdit => Me?.HasRole(VimRole.FinanceManager) == true;

    protected override async Task LoadAsync()
    {
        var routes = await InScope(sp => sp.GetRequiredService<IRouteRepository>().ListAsync(default));
        _rows = routes.OrderBy(r => r.Code).Select(r => new Row
        {
            Code = r.Code, DisplayName = r.DisplayName, ReviewerName = r.ReviewerName,
            ReviewerId = r.ReviewerId, Delegates = r.DelegateIds, Active = r.Active,
        }).ToList();
    }

    private Task SaveAsync() => RunActionAsync(async sp =>
    {
        if (!CanEdit)
        {
            throw new DomainRuleException(RuleCodes.RoleNotPermitted, "Only the Finance Manager can change routing.");
        }

        var repo = sp.GetRequiredService<IRouteRepository>();
        var ctx = ActionContext.For(Me!, sp.GetRequiredService<IClock>().UtcNow);
        foreach (var row in _rows)
        {
            var route = await repo.GetAsync(row.Code, default) ?? throw new NotFoundException($"Route {row.Code} not found.");
            var delegates = row.Delegates.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var change = route.Update(row.DisplayName, row.ReviewerId, row.ReviewerName, delegates, row.Active, ctx);
            if (change is not null)
            {
                repo.AddChange(change); // insert-only history: who changed which reviewer, from what to what
            }
        }

        await sp.GetRequiredService<IUnitOfWork>().SaveChangesAsync(default);
    }, "Routing saved.");
}
