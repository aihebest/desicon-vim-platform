{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<desicon-tenant-id>",
    "ClientId": "<workbench-app-registration-client-id>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "ConnectionStrings": {
    "VimDb": "Server=tcp:<sql-server>.database.windows.net,1433;Database=<db>;Authentication=Active Directory Default;Encrypt=True;"
  },
  "Storage": {
    "BlobServiceUri": "https://<account>.blob.core.windows.net/",
    "DocumentsContainer": "case-documents"
  },
  "DocumentIntelligence": {
    "Endpoint": ""
  },
  "BusinessCentral": {
    "Enabled": false
  },
  "Vim": {
    "WorkbenchUrl": "https://localhost:5001",
    "FinanceManagerEmail": "",
    "AccountsPayableEmail": "",
    "MaxAttachmentMegabytes": 25,
    "VerificationHours": 48,
    "VerificationBasis": "CalendarHours",
    "Routes": {
      "PMC": { "ReviewerId": "", "ReviewerName": "PMC Project Secretary" },
      "GMC": { "ReviewerId": "", "ReviewerName": "GMC Cost Controller" },
      "GS": { "ReviewerId": "", "ReviewerName": "General Services Manager" },
      "ADMIN_LOGISTICS": { "ReviewerId": "", "ReviewerName": "Logistics Manager" },
      "SECURITY": { "ReviewerId": "", "ReviewerName": "Security Manager" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
