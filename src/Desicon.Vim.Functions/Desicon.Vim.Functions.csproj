<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Background jobs (Azure Functions, isolated worker): mailbox intake, SLA
    reminders/escalations and outbound notification dispatch. All business
    logic lives in Application/Infrastructure; these functions only schedule it.
  -->
  <PropertyGroup>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Desicon.Vim.Functions</RootNamespace>
    <!--
      CA1515 ("make public types internal") targets executables, but the
      Functions SDK discovers function classes by reflection/source generation
      and they are conventionally public.
    -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.51.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Desicon.Vim.Application\Desicon.Vim.Application.csproj" />
    <ProjectReference Include="..\Desicon.Vim.Infrastructure\Desicon.Vim.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
